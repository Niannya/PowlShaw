# Copy to .env.local and replace every value before deployment.
# ADMIN_PASSWORD is only used to initialize the database. Change it later at /admin/security.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=data/poxiao.db
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only enable this when the app is behind a trusted reverse proxy you control.
TRUST_PROXY_HEADERS=0
# Optional comma-separated hostnames allowed to load scripts from the local development server.
ALLOWED_DEV_ORIGINS=
