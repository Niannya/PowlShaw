{
  "name": "@powlshaw/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "seed:dev": "node scripts/seed_dev.mjs",
    "admin:reset": "node scripts/reset_admin_credentials.mjs",
    "db:import-activities": "python scripts/import_remaining_activities.py",
    "db:import-event-documents": "python scripts/import_event_documents.py",
    "db:migrate-slugs": "node scripts/migrate_url_slugs.mjs --execute"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "better-sqlite3": "13.0.3",
    "mammoth": "^1.12.2",
    "marked": "^18.0.13",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.9.0"
  }
}
