# Copy to .env.local and fill in the real credentials.
# 单应用部署：Next.js 页面与 Hono API 共用同一份环境变量。

# ---------------------------------------------------------------- 站点与安全
# 用于 canonical / Open Graph / sitemap 的公开站点地址（本地开发为 http://localhost:3000）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 至少 32 个字符；用于 HMAC-SHA256 双轨会话签名。生产环境务必使用随机值。
SESSION_SECRET=replace-with-at-least-32-random-characters
# 仅用于首次初始化管理员账号；登录后请在 /admin/security 修改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# 仅当应用位于你完全信任的反向代理之后时才设为 1。
TRUST_PROXY_HEADERS=0
# 可选：允许访问本地开发服务器的额外主机名，逗号分隔。
ALLOWED_DEV_ORIGINS=

# ---------------------------------------------------------------- 云数据库
# Turso (libSQL) 连接串。本地可使用 `turso dev --db-file local.db` 启动兼容服务，
# 并设为 http://127.0.0.1:8080。
TURSO_DATABASE_URL=
# 云端 Turso 数据库的访问令牌；本地 `turso dev` 可留空。
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------ 对象存储（Blob）
# Vercel Blob 读写令牌；用于活动评议资料 ≤ 20 MB 的浏览器直传。
BLOB_READ_WRITE_TOKEN=
# 可选：Blob 公网域名后缀。默认 .public.blob.vercel-storage.com；
# 使用私有 Blob 或自定义域名时覆盖（例如 .private.blob.vercel-storage.com）。
BLOB_HOST_SUFFIX=
