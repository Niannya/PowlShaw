# Copy to .env.local and adjust.
# 浏览器与 Next 服务端默认访问 http://127.0.0.1:3001 的后端。
API_INTERNAL_URL=http://127.0.0.1:3001
# 浏览器请求 /api/v1、/uploads 时的转发目标；生产环境若由 Nginx 反代，请设为空字符串。
API_PROXY_TARGET=http://127.0.0.1:3001
# 用于 canonical / Open Graph / sitemap 的公开站点地址。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 可选：允许访问本地开发服务器的额外主机名，逗号分隔。
ALLOWED_DEV_ORIGINS=
