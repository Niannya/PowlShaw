{
  "name": "@powlshaw/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:init": "node --env-file-if-exists=.env.local scripts/init_local_db.mjs",
    "db:migrate": "python scripts/migrate_sqlite_to_turso.py",
    "reset:admin": "node --env-file-if-exists=.env.local scripts/reset_admin.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import_turso_dump.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.9.0",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "mammoth": "^1.12.2",
    "marked": "^18.0.13",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.9.0"
  }
}
