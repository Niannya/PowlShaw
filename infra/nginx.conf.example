# PowlShaw 同源反向代理示例
#
# 目标拓扑：
#   /          -> Next.js 前端 apps/web   :3000
#   /api/v1    -> 独立后端 apps/api       :3001
#   /uploads   -> 后端上传目录/对象存储    :3001
#
# 生产环境构建 apps/web 时把 API_PROXY_TARGET 设为空字符串，
# 避免 Next 再转发一层；所有浏览器请求都由本文件转发。

upstream powlshaw_web {
    server 127.0.0.1:3000;
    keepalive 16;
}

upstream powlshaw_api {
    server 127.0.0.1:3001;
    keepalive 16;
}

server {
    listen 80;
    server_name example.com;

    # 活动资料上限 20MB，图片 5MB；留出 multipart 开销。
    client_max_body_size 25m;

    # 如已配置 HTTPS，可取消注释并考虑 HSTS。
    # listen 443 ssl http2;
    # ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # 后端接口：同源，浏览器不感知端口。
    location /api/v1/ {
        proxy_pass http://powlshaw_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 后台上传的图片与活动资料；迁移到对象存储后可改为 S3/CDN。
    location /uploads/ {
        proxy_pass http://powlshaw_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1h;
    }

    # 前端 SSR 页面与静态资源。
    location / {
        proxy_pass http://powlshaw_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
