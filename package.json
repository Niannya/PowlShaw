{
  "name": "powlshaw",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @powlshaw/web dev",
    "dev:web": "pnpm --filter @powlshaw/web dev",
    "build": "pnpm --filter @powlshaw/web build",
    "start": "pnpm --filter @powlshaw/web start",
    "lint": "pnpm --filter @powlshaw/web lint",
    "typecheck": "pnpm --filter @powlshaw/web typecheck",
    "test": "pnpm --filter @powlshaw/web test",
    "check": "pnpm format:check && pnpm --filter @powlshaw/web check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
